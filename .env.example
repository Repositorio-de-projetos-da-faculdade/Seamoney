# Copy to .env next to docker-compose.yml. Never commit real values.

# Testnet wallet that plays the "authorized partner" (Tempo Moderato TESTNET only, no real money).
# Create and fund one with:  cd chain-service && python -m scripts.setup_wallets
TEMPO_PARTNER_PRIVATE_KEY=

# Optional: real AI invoice reading. Without it the app runs in clearly-labelled demo mode.
ANTHROPIC_API_KEY=

# Shared secret between the Java and Python services. Change it for any shared deployment.
CHAIN_SERVICE_TOKEN=dev-internal-token

# Simulated USD/BRL rate shown in quotes (no real FX happens).
DEMO_USD_BRL=5.40
# Demo companies, users (password demo123) and order history on first start. false starts with an empty database.
# Seeding only happens with SPRING_PROFILES_ACTIVE=demo (the docker-compose default) and an empty database.
SEED_DEMO=true
# Host port for the web app.
WEB_PORT=3000

# Optional: password to block public access to the demo. Set it for any deployment others can reach:
# without it anyone could send testnet payments.
DEMO_ACCESS_PASSWORD=
# Secret that signs the session cookie, at least 16 characters. Required when a password is set (the gate refuses to run without it)
DEMO_SESSION_SECRET=

# Postgres database configuration
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=seamoney

# Signs the login tokens. Required: a random string of 32+ characters. The service refuses to start without one.
# Generate:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=

# Optional: signs the public proof links (the supplier's page). Empty = derived from JWT_SECRET.
# Changing it breaks the links already shared.
PROOF_SECRET=

# Optional: a payment that was started and never confirmed is not sent again for this many seconds (it may still be
# mined); after that, if it is not on the chain, it is treated as lost and the order can be paid again. Default 600.
PAYMENT_PENDING_GRACE_SECONDS=600

# Optional: set to false to stop the background job that settles orders left in "sending".
RECOVERY_ENABLED=true

# Optional: force the Secure flag of the session cookies (true or false). Empty = Secure only when the request reached
# the app as HTTPS (the proxy in front must send X-Forwarded-Proto). A demo served over plain HTTP cannot sign in
# with a Secure cookie, so put HTTPS (Caddy, a load balancer) in front of any shared deployment.
COOKIE_SECURE=

# Optional Solana devnet payer (base58 secret key). Without it, one is derived from the Tempo testnet key.
SOLANA_PAYER_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
