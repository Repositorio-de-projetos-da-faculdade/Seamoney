# Copy to .env next to docker-compose.yml. Never commit real values.

# Testnet wallet that plays the "authorized partner" (Tempo Moderato TESTNET only, no real money).
# Create and fund one with:  cd chain-service && python -m scripts.setup_wallets
TEMPO_PARTNER_PRIVATE_KEY=

# Optional: real AI invoice reading. Without it the app runs in clearly-labelled demo mode.
ANTHROPIC_API_KEY=

# Shared secret between the Java and Python services. Change it for any shared deployment.
CHAIN_SERVICE_TOKEN=dev-internal-token

# Simulated USD/BRL rate shown in quotes (no real FX happens).
DEMO_USD_BRL=5.40
# false starts with an empty database instead of the demo history.
SEED_DEMO=true
# Host port for the web app.
WEB_PORT=3000

# Postgres database configuration
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=seamoney

# JWT Secret for authentication (must be a secure random string)
JWT_SECRET=your_secure_jwt_secret_that_should_be_long_enough
