# Copy to .env.local for local development.

# Where the Java rules API runs (server-side only; read at request time).
RULES_API_URL=http://localhost:8080

# AI invoice reading (optional). Without it the app runs in clearly-labelled demo mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Public address of the site, used for absolute links to the share image (set when deploying).
# SITE_URL=https://example.com
