# Copy to .env for local development (uvicorn --env-file .env). Never commit real values.

# Testnet wallet that plays the "authorized partner". Generate with: python -m scripts.setup_wallets
TEMPO_PARTNER_PRIVATE_KEY=

# Optional
# TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_GAS_LIMIT=500000

# When set, every call except /health must send it as the X-Internal-Token header.
# CHAIN_SERVICE_TOKEN=
